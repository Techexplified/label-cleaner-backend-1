# ==============================================================================
# 🏷️ LABEL CLEANER FOR TRELLO - ENVIRONMENT VARIABLES TEMPLATE (VERCEL)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRELLO API CREDENTIALS
# ------------------------------------------------------------------------------
VITE_TRELLO_API_KEY=your_32_character_trello_api_key_here
VITE_TRELLO_APP_NAME="Label Cleaner Power-Up"
VITE_TRELLO_POWERUP_ID=your_trello_powerup_id_here

# ------------------------------------------------------------------------------
# 2. APPLICATION & DEPLOYMENT URLS (Vercel)
# ------------------------------------------------------------------------------
# Set this to your live Vercel domain (e.g. https://your-project.vercel.app)
VITE_APP_URL=https://your-domain.vercel.app
VITE_TRELLO_OAUTH_REDIRECT_URL=https://your-domain.vercel.app/auth.html

# ------------------------------------------------------------------------------
# 3. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.your-domain.com/api

# ------------------------------------------------------------------------------
# 4. SERVER / BACKEND SECRETS (Do NOT commit real values to Git)
# ------------------------------------------------------------------------------
PORT=5173
TRELLO_API_SECRET=your_trello_api_secret_here
TRELLO_API_TOKEN=your_trello_member_token_here
CORS_ORIGIN=https://your-domain.vercel.app,https://trello.com,http://localhost:5173
SESSION_SECRET=your_super_secret_session_key_here
