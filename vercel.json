{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://trello.com https://*.trello.com;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/connector",
      "destination": "/connector.html"
    },
    {
      "source": "/auth",
      "destination": "/auth.html"
    }
  ]
}
